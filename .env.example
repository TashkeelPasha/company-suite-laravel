APP_NAME="Company Suite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-cpanel-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=info

# The backend JSON API base URL exposed to the frontend JS.
# Keep same-origin in production (recommended) — leave as /api.
# For dev against a remote API, set to the full URL and enable CORS on the API side.
VITE_API_BASE_URL=/api

# Database is used only if this Laravel app runs the API too.
# For a frontend-only deployment this can be left blank.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=company_suite
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
